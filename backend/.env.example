# ==============================================================================
# Codevo Backend Environment Configuration (Example)
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit .env containing real credentials or secrets to version control.
# ==============================================================================

# Application Environment: development | test | production
ENVIRONMENT=development

# Debug Mode: true | false (Must be false in production)
DEBUG=true

# Service Host & Port
# Default to 127.0.0.1 for local workstation development to prevent unintended LAN exposure.
# Containerized deployments (e.g., Docker) require 0.0.0.0 to receive bridged/forwarded network traffic.
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins
# Comma-separated list of authorized origins (e.g., http://localhost:3000)
# Wildcards (*) are strictly rejected in production.
ALLOWED_ORIGINS=http://localhost:3000

# Service-to-Service Internal Authentication Key
# High-entropy shared secret between Next.js BFF and FastAPI backend.
# In production, must be at least 16 characters and not use development defaults.
INTERNAL_SERVICE_KEY=dev-internal-service-key-change-in-production

# Supabase Authentication & JWKS Verification
# Production requires HTTPS (e.g. https://<project-ref>.supabase.co)
# Local Supabase CLI development permits HTTP loopback (e.g. http://localhost:54321 or http://127.0.0.1:54321)
# Derived Endpoints:
#   Issuer:   {SUPABASE_URL}/auth/v1
#   JWKS URI: {SUPABASE_URL}/auth/v1/.well-known/jwks.json
#   Audience: authenticated
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWKS_CACHE_TTL_SECONDS=600
SUPABASE_JWKS_TIMEOUT_SECONDS=5.0

